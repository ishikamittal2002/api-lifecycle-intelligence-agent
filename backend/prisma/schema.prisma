generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EndpointStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Repository {
  id            String     @id @default(uuid())
  name          String
  repoUrl       String?
  localPath     String
  lastScannedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  endpoints     Endpoint[]
}

model Endpoint {
  id           String                @id @default(uuid())
  repositoryId String
  repository   Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  method       String
  path         String
  filePath     String
  lineNumber   Int
  handlerName  String?
  status       EndpointStatus        @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  usageMetrics UsageMetric[]
  reports      InvestigationReport[]

  @@unique([repositoryId, method, path])
}

model UsageMetric {
  id           String    @id @default(uuid())
  endpointId   String
  endpoint     Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  requestCount Int       @default(0)
  lastCalledAt DateTime?
  avgLatencyMs Float?
  windowDays   Int       @default(30)
  recordedAt   DateTime  @default(now())
}

model InvestigationReport {
  id                String         @id @default(uuid())
  endpointId        String
  endpoint          Endpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  riskLevel         RiskLevel
  summary           String
  reasoning         String
  evidence          Json
  recommendedAction String
  approvalStatus    ApprovalStatus @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}
